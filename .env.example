# Vercel Environment Variables Template
# Copy this file to .env.local and fill in actual values
# These will be automatically set in Vercel project settings

# Frontend Configuration
VITE_API_URL=https://langcoach.vercel.app

# Database Configuration - Supabase PostgreSQL
# Get this from your Supabase project: Settings > Database > Connection string
# Example: postgresql://postgres:[PASSWORD]@[HOST]:5432/[DB_NAME]
POSTGRES_URL=postgresql://postgres:password@localhost:5432/langcoach

# CORS Configuration (Security)
# Specify allowed origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://langcoach.vercel.app

# Application Environment
NODE_ENV=production

# OpenAI API
OPENAI_API_KEY=sk-your-openai-key-here

# ElevenLabs API
ELEVENLABS_API_KEY=your-elevenlabs-key-here

# Optional: Logging & Monitoring
LOG_LEVEL=info
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Optional: Analytics
ANALYTICS_ID=your-analytics-id
